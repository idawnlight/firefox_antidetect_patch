mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/../build/obj-firefox-stable-160
mk_add_options MOZ_MAKE_FLAGS="-j32"
mk_add_options MOZ_INSTALLER=0
mk_add_options MOZ_AUTOMATION_INSTALLER=0
mk_add_options 'export RUSTC_WRAPPER=sccache'
mk_add_options 'export SCCACHE_CACHE_SIZE=50G'
mk_add_options "export MOZ_BUILD_DATE=${MOZ_BUILD_DATE:-$(date -u +%Y%m%d%H%M%S)}"
ac_add_options --enable-project=browser
ac_add_options --enable-release
ac_add_options --disable-debug
ac_add_options --disable-debug-symbols
ac_add_options --enable-bundled-fonts
ac_add_options --enable-rust-simd
ac_add_options --with-ccache=sccache
ac_add_options --enable-update-channel=release
export MOZILLA_OFFICIAL=1
export MAR_CHANNEL_ID=firefox-mozilla-release
export ACCEPTED_MAR_CHANNEL_IDS=firefox-mozilla-release
